{
    "name": "universal-code-generator",
    "version": "1.0.0",
    "description": "Universal Code Generator Desktop Application",
    "main": "dist-electron/main.js",
    "type": "module",
    "scripts": {
        "start": "npm run electron:dev",
        "dev": "npm run electron:dev",
        "web:dev": "vite",
        "build:electron": "node build-electron.js",
        "build": "npm run build:electron && vite build",
        "build:all": "npm run build && electron-builder",
        "preview": "vite preview",
        "electron:dev": "npm run build:electron && concurrently \"vite\" \"wait-on http://localhost:5190 && electron .\"",
        "electron:build": "npm run build:all"
    },
    "keywords": [
        "electron",
        "react",
        "typescript",
        "code-generator"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/handlebars": "^4.0.40",
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@vitejs/plugin-react": "^4.2.1",
        "concurrently": "^8.2.2",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "esbuild": "^0.19.8",
        "playwright": "^1.64.1",
        "prettier-plugin-handlebars": "^0.0.1",
        "typescript": "^5.3.3",
        "vite": "^5.0.8",
        "wait-on": "^7.2.0"
    },
    "dependencies": {
        "@emotion/react": "^11.11.1",
        "@emotion/styled": "^11.11.0",
        "@mui/icons-material": "^5.15.0",
        "@mui/material": "^5.15.0",
        "@reduxjs/toolkit": "^2.0.1",
        "bcryptjs": "3.0.3",
        "handlebars": "^4.7.8",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-redux": "^9.0.4"
    }
}
