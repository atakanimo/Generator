/** The list query without paging (filters, `beforeList`, sort, populate, `mapRows`); CSV text or the 400 response. */
export async function exportCsv(
  body?: ExportRequest & { filters?: Get{{entityName}}Filters; sortBy?: string; sortOrder?: 'asc' | 'desc' }
): Promise<IApiResponse<string>> {
  const columns = resolveExportColumns(body ?? {}, exportColumns);
  if ('isSuccess' in columns) return columns;
  const listFilters = body?.filters ?? ({} as Get{{entityName}}Filters);
  const filtersQuery = build{{entityName}}FilterQuery(
    hooks.beforeList ? await hooks.beforeList(listFilters) : listFilters
  ) as FilterQuery<I{{entityName}}Model>;
  const found = await crud.find(filtersQuery, {
    sort: resolveListSort(body?.sortBy, body?.sortOrder, hooks.defaultSort ?? { createdAt: -1, _id: -1 }){{beServicePopulateOptionLine fields}},
    limit: EXPORT_ROW_LIMIT + 1
  });
  if (!found.isSuccess || found.data == null) return found as unknown as IApiResponse<string>;
  if (found.data.length > EXPORT_ROW_LIMIT) return exportTooMany();
  const rows = hooks.mapRows ? await hooks.mapRows(found.data as HookRow[]) : found.data;
  return SuccessResponse(renderCsv(rows, columns.fields, columns.headers, exportColumns.display));
}

