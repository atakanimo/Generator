  const { filters: filterObj, limit, page, sortBy, sortOrder } = extractListPagination(
    filters as Record<string, unknown> | undefined
  );
  const listFilters = (filterObj as Get{{entityName}}Filters) || {};
  const filtersQuery = build{{entityName}}FilterQuery(
    hooks.beforeList ? await hooks.beforeList(listFilters) : listFilters
  ) as FilterQuery<I{{entityName}}Model>;

  const result = await crud.getAllPaginated(filtersQuery, {
    limit,
    page,
    sort: resolveListSort(sortBy, sortOrder, hooks.defaultSort ?? { createdAt: -1, _id: -1 }){{beServicePopulateOptionLine fields}}{{#if listProjection}},
    projection: '{{listProjection}}'{{/if}}
  });
  return mapListRows(result, hooks.mapRows?.bind(hooks));
}

