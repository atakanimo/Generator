// Auto Generated By Generator - {{currentDate}}
import React, { useState, useEffect } from 'react';
import {
  TextField,
  Box,
  Switch,
  FormControlLabel,
  Select,
  MenuItem,
  FormControl,
  InputLabel,
  Typography,
  Button,
  Avatar,
} from '@mui/material';
import { DatePicker } from '@mui/x-date-pickers/DatePicker';
import { LocalizationProvider } from '@mui/x-date-pickers/LocalizationProvider';
import { AdapterDateFns } from '@mui/x-date-pickers/AdapterDateFns';
import CoreModal from '@/components/CoreModal';
import { I{{entityName}}, I{{entityName}}Input } from '@/services/{{camelEntityName}}.service';

interface {{entityName}}ModalProps {
  open: boolean;
  onClose: () => void;
  onSave: (data: I{{entityName}}Input) => Promise<void>;
  item?: I{{entityName}} | null;
  mode: 'create' | 'edit';
}

const {{entityName}}Modal: React.FC<{{entityName}}ModalProps> = ({ open, onClose, onSave, item, mode }) => {
  const [formData, setFormData] = useState<I{{entityName}}Input>({} as I{{entityName}}Input);
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    if (mode === 'edit' && item) {
      // Populate form with item data
      const initialData: any = { ...item };
      setFormData(initialData as I{{entityName}}Input);
    } else {
      // Reset form for create mode
      setFormData({} as I{{entityName}}Input);
    }
  }, [item, mode, open]);

  const handleChange = (field: string, value: any) => {
    setFormData(prev => ({
      ...prev,
      [field]: value,
    }));
  };

  const handleSubmit = async () => {
    try {
      setLoading(true);
      // Data hazırlığı
      let dataToSave: any = { ...formData };

      // Boolean field'ları kontrol et: eğer undefined ise false olarak set et
      {{#each fields}}
      {{#if (eq type "boolean")}}
      if (dataToSave['{{name}}'] === undefined) {
        dataToSave['{{name}}'] = false;
      }
      {{/if}}
      {{/each}}

      // Relation alanları obje olarak kaldıysa (kullanıcı dokunmadıysa) içinden ID'yi al
      Object.keys(dataToSave).forEach(key => {
        const val = dataToSave[key];
        if (val && typeof val === 'object' && !Array.isArray(val)) {
            // Backend'in beklediği formata göre _id veya id
             {{#if (eq sourceType "nodejs-mongoose")}}
             dataToSave[key] = val._id || val.id;
             {{else}}
             dataToSave[key] = val.id;
             {{/if}}
        }
      });

      // Remove main ID field from payload
      {{#if (eq sourceType "nodejs-mongoose")}}
      delete dataToSave._id;
      {{else}}
      delete dataToSave.id;
      {{/if}}

      await onSave(dataToSave);
      onClose();
    } catch (error) {
      console.error('Error saving {{entityName}}:', error);
    } finally {
      setLoading(false);
    }
  };

  const renderField = (field: any) => {
    const fieldName = field.name;
    const value = formData[fieldName as keyof I{{entityName}}Input];
    // ID alanları için kontrol (read-only/disabled)
    const isReadOnly = fieldName === 'id' || fieldName === '_id';

    switch (field.uiComponent) {
      case 'TextField':
        return (
          <TextField
            key={fieldName}
            label={field.label}
            value={value || ''}
            onChange={(e) => handleChange(fieldName, e.target.value)}
            fullWidth
            required={field.required}
            margin="normal"
            disabled={isReadOnly}
          />
        );
      case 'TextArea':
        return (
          <TextField
            key={fieldName}
            label={field.label}
            value={value || ''}
            onChange={(e) => handleChange(fieldName, e.target.value)}
            fullWidth
            required={field.required}
            margin="normal"
            multiline
            rows={4}
            disabled={isReadOnly}
          />
        );
      case 'NumberField':
        return (
          <TextField
            key={fieldName}
            label={field.label}
            type="number"
            value={value || ''}
            onChange={(e) => handleChange(fieldName, parseFloat(e.target.value) || 0)}
            fullWidth
            required={field.required}
            margin="normal"
            disabled={isReadOnly}
          />
        );
      case 'Switch':
        return (
          <FormControlLabel
            key={fieldName}
            control={
              <Switch
                checked={value === true}
                onChange={(e) => handleChange(fieldName, e.target.checked)}
                disabled={isReadOnly}
              />
            }
            label={field.label}
          />
        );
      case 'DatePicker':
        return (
          <LocalizationProvider key={fieldName} dateAdapter={AdapterDateFns}>
            <DatePicker
              label={field.label}
              value={value ? new Date(value as any) : null}
              onChange={(newValue) => handleChange(fieldName, newValue)}
              disabled={isReadOnly}
              slotProps=\{{
                textField: {
                  fullWidth: true,
                  required: field.required,
                  margin: 'normal' as const,
                },
              }}
            />
          </LocalizationProvider>
        );
      case 'Select':
        return (
          <FormControl key={fieldName} fullWidth margin="normal" disabled={isReadOnly}>
            <InputLabel>{field.label}</InputLabel>
            <Select
              value={value || ''}
              onChange={(e) => handleChange(fieldName, e.target.value)}
              label={field.label}
              required={field.required}
            >
              <MenuItem value="">Select {field.label}</MenuItem>
              {/* TODO: Add options dynamically */}
            </Select>
          </FormControl>
        );
      case 'MultiSelect':
        return (
          <FormControl key={fieldName} fullWidth margin="normal" disabled={isReadOnly}>
            <InputLabel>{field.label}</InputLabel>
            <Select
              multiple
              value={Array.isArray(value) ? value : []}
              onChange={(e) => handleChange(fieldName, e.target.value)}
              label={field.label}
              required={field.required}
            >
               {/* TODO: Add options dynamically */}
            </Select>
          </FormControl>
        );
      case 'ImageField':
        return (
          <Box key={fieldName} sx=\{{ mb: 2 }}>
            <TextField
              label={field.label}
              value={value || ''}
              onChange={(e) => handleChange(fieldName, e.target.value)}
              fullWidth
              required={field.required}
              margin="normal"
              disabled={isReadOnly}
              placeholder="Enter image URL or base64 string"
              helperText="Supports URL or base64 encoded image"
            />
            {value && (() => {
              const imageValue = value;
              const isBase64 = typeof imageValue === 'string' && 
                (imageValue.startsWith('/9j/') || 
                 imageValue.startsWith('iVBORw0KGgo') || 
                 imageValue.startsWith('UklGR') ||
                 (imageValue.length > 100 && !imageValue.startsWith('http')));
              const imageSrc = isBase64 && !imageValue.startsWith('data:image/')
                ? `data:image/jpeg;base64,${imageValue}`
                : imageValue;
              return (
                <Box sx=\{{ mt: 2, display: 'flex', justifyContent: 'center' }}>
                  <Avatar
                    src={imageSrc}
                    alt={field.label}
                    sx=\{{ width: 100, height: 100 }}
                    variant="rounded"
                  />
                </Box>
              );
            })()}
          </Box>
        );
      default:
        return (
          <TextField
            key={fieldName}
            label={field.label}
            value={value || ''}
            onChange={(e) => handleChange(fieldName, e.target.value)}
            fullWidth
            required={field.required}
            margin="normal"
            disabled={isReadOnly}
          />
        );
    }
  };

  return (
      <CoreModal
        open={open}
        onClose={onClose}
        onSave={handleSubmit}
        title={mode === 'create' ? `Create New {{entityName}}` : `Edit {{entityName}}`}
        loading={loading}
        saveLabel={mode === 'create' ? 'Create' : 'Update'}
      >
        {{#each fields}}
        {{#if showInForm}}
            {{#if includeRelation}}
              {{#if relationEntityName}}
                  {/* Relation Field Logic: Shows Name if object, allows typing ID */}
                  <TextField
                    key="{{name}}"
                    label="{{label}}"
                    value={
                      formData['{{name}}'] && typeof formData['{{name}}'] === 'object'
                        ? (formData['{{name}}'] as any)?.['{{relationProperty}}'] || ''
                        : formData['{{name}}'] || ''
                    }
                    onChange={(e) => handleChange('{{name}}', e.target.value)}
                    fullWidth
                    required={ {{required}} }
                    margin="normal"
                    helperText={
                       formData['{{name}}'] && typeof formData['{{name}}'] === 'object'
                       ? "Currently showing related name. Edit to enter a new ID."
                       : "Enter {{relationEntityName}} ID"
                    }
                  />
              {{else}}
                  {renderField({
                    name: '{{name}}',
                    label: '{{label}}',
                    type: '{{type}}',
                    required: {{required}},
                    isArray: {{isArray}},
                    uiComponent: '{{uiComponent}}',
                  })}
              {{/if}}
            {{else}}
              {renderField({
                name: '{{name}}',
                label: '{{label}}',
                type: '{{type}}',
                required: {{required}},
                isArray: {{isArray}},
                uiComponent: '{{uiComponent}}',
              })}
            {{/if}}
        {{/if}}
        {{/each}}
      </CoreModal>
  );
};

export default {{entityName}}Modal;