def ids(row: dict[str, Any]) -> dict[str, Any]:
    """Populate edilen reference'lar (list / getOne'da `{id, ...}`) id'ye indirgenir; create / update id döner."""
    out = dict(row)
    for key in POPULATED:
        value = out.get(key)
        if isinstance(value, dict):
            out[key] = value["id"]
        elif isinstance(value, list):
            out[key] = [v["id"] if isinstance(v, dict) else v for v in value]
    return out


def error(resp: Any, status: int) -> dict[str, Any]:
    assert resp.status_code == status, resp.text
    payload = resp.json()
    assert set(payload) == ENVELOPE_KEYS
    assert payload["isSuccess"] is False and payload["data"] is None
    assert payload["errorData"]["code"] == status
    return payload


