async def test_auth_and_envelope(client, make_token, h) -> None:
    error(await client.post(f"{BASE}/get-all", json={}), 401)
    user = {"Authorization": f"Bearer {make_token('u1', role='user')}"}
    error(await client.post(f"{BASE}/get-all", json={}, headers=user), 403)
    resp = await client.post(f"{BASE}/get-all", headers={**h, "X-Request-Id": "trace-1"})
    assert resp.status_code == 200, resp.text
    payload = resp.json()
    assert set(payload) == ENVELOPE_KEYS and payload["isSuccess"] is True and payload["traceId"] == "trace-1"
    assert payload["data"] == {
        "items": [],
        "total": 0,
        "hasMore": False,
        "currentPage": 1,
        "currentLimit": 50,
    }


