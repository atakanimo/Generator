async def test_list_paging_filter_sort(client, h, refs) -> None:
    first = await create(client, h, body(0, refs))
    second = await create(client, h, body(1, refs))

    async def listed(payload: dict[str, Any]) -> dict[str, Any]:
        resp = await client.post(f"{BASE}/get-all", json=payload, headers=h)
        assert resp.status_code == 200, resp.text
        return resp.json()["data"]

    page = await listed({})
    assert page["total"] == 2
    assert all(item[field] is None for item in page["items"] for field in DETAIL_ONLY)
    assert [i["id"] for i in page["items"]] == [second["id"], first["id"]]  # createdAt desc
    page = await listed({"page": 2, "limit": 1})
    assert (page["total"], page["hasMore"], page["currentPage"], page["currentLimit"]) == (2, False, 2, 1)
    assert [i["id"] for i in page["items"]] == [first["id"]]
