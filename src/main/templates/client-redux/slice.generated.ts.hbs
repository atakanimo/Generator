import type { ActionReducerMapBuilder, PayloadAction } from '@reduxjs/toolkit';
import type { {{sliceTypeImports}} } from '{{imports.services}}/{{camel}}.service.generated';
{{#if hasSavedType}}
import { {{populateHelpers}} } from '{{imports.services}}/common.generated';
{{/if}}
import type { {{entity}}Thunks } from '../thunks/{{camel}}.thunk.generated';

export interface {{entity}}BaseState {
  items: {{names.row}}[];
  currentItem: {{names.row}} | null;
  total: number;
  page: number;
  limit: number;
  hasMore: boolean;
  /** The list was fetched at least once (success or not): an empty `items` then means "no rows", not "not loaded yet". */
  listLoaded: boolean;
}

export const {{camel}}InitialState: {{entity}}BaseState = {
  items: [],
  currentItem: null,
  total: 0,
  page: 1,
  limit: 50,
  hasMore: false,
  listLoaded: false
};

export const {{camel}}BaseReducers = {
  setCurrentItem: (state: {{entity}}BaseState, action: PayloadAction<{{names.row}} | null>) => {
    state.currentItem = action.payload;
  },
  clearCurrentItem: (state: {{entity}}BaseState) => {
    state.currentItem = null;
  }
};
{{#if hasWrites}}

/** Row after create / update: the answer's fields over the known row{{#if populatedRefs.length}}; relations stay populated while their id is unchanged{{/if}}. */
export const merge{{entity}}Saved = (prev: {{names.row}} | undefined, saved: {{names.saved}}): {{names.row}} => ({
  ...prev,
  ...saved{{#each populatedRefs}},
  {{name}}: {{#if isArray}}keepPopulatedAll{{else}}keepPopulated{{/if}}(prev?.{{name}}, saved.{{name}}) as {{../names.row}}['{{name}}']{{/each}}
});
{{/if}}

/**
 * Fulfilled cases of the generated thunks (a failed call leaves the state as it is). `S` is the module's own state;
 * the cases touch only the base fields.
 */
export const add{{entity}}BaseCases = <S extends {{entity}}BaseState>(stateBuilder: ActionReducerMapBuilder<S>, thunks: {{entity}}Thunks) => {
  const builder = stateBuilder as unknown as ActionReducerMapBuilder<{{entity}}BaseState>;
{{#if ops.list}}
  builder.addCase(thunks.{{thunks.list}}.fulfilled, (state, action) => {
    state.listLoaded = true;
    if (!action.payload.isSuccess || !action.payload.data) return;
    const { data } = action.payload;
    state.items = action.meta.arg?.append === true ? [...state.items, ...data.items] : data.items;
    state.total = data.total;
    state.hasMore = data.hasMore;
    state.page = data.currentPage;
    state.limit = data.currentLimit;
  });
{{/if}}
{{#if ops.getOne}}
  builder.addCase(thunks.{{thunks.getOne}}.fulfilled, (state, action) => {
    if (!action.payload.isSuccess || !action.payload.data) return;
    state.currentItem = action.payload.data;
  });
{{/if}}
{{#if ops.create}}
  builder.addCase(thunks.{{thunks.create}}.fulfilled, (state, action) => {
    if (!action.payload.isSuccess || !action.payload.data) return;
    // Lists are newest first (contract §3 default sort).
    state.items.unshift(merge{{entity}}Saved(undefined, action.payload.data));
    state.total += 1;
  });
{{/if}}
{{#if ops.update}}
  builder.addCase(thunks.{{thunks.update}}.fulfilled, (state, action) => {
    if (!action.payload.isSuccess || !action.payload.data) return;
    const saved = action.payload.data;
    const index = state.items.findIndex(item => item.id === saved.id);
    if (index !== -1) state.items[index] = merge{{entity}}Saved(state.items[index], saved);
    if (state.currentItem?.id === saved.id) state.currentItem = merge{{entity}}Saved(state.currentItem, saved);
  });
{{/if}}
{{#if ops.delete}}
  builder.addCase(thunks.{{thunks.delete}}.fulfilled, (state, action) => {
    if (!action.payload.isSuccess) return;
    // The answer's `data` is `null` (contract §2): the id is the thunk argument.
    const id = action.meta.arg;
    const before = state.items.length;
    state.items = state.items.filter(item => item.id !== id);
    state.total = Math.max(0, state.total - (before - state.items.length));
    if (state.currentItem?.id === id) state.currentItem = null;
  });
{{/if}}
};
