/** Flags the host interceptor reads (contract §7), plus host-specific headers of a call (e.g. `premiumUx`). */
export type RequestOptions = {
  /** Background request: no global loading. */
  skipLoading?: boolean;
{{#unless headers}}
  /** No success toast (`uiMessage`); reads skip it by default. */
  skipSuccessToast?: boolean;
{{/unless}}
  headers?: Record<string, string>;
};

/** Axios config part carrying the options{{#if headers}} (this host's interceptor reads the flags from the headers){{/if}}. `read`: list / getOne. */
{{#if headers}}
export const requestFlags = (options?: RequestOptions, _read = false) => {
  const headers = { ...options?.headers, ...(options?.skipLoading ? { skipLoading: true } : {}) };
  return Object.keys(headers).length ? { headers } : {};
};
{{else}}
export const requestFlags = (options?: RequestOptions, read = false) => ({
  ...(options?.skipLoading ? { skipLoading: true } : {}),
  ...((options?.skipSuccessToast ?? read) ? { skipSuccessToast: true } : {}),
  ...(options?.headers ? { headers: options.headers } : {})
});
{{/if}}

/**
 * A relation after create / update (the answer carries its id): the populated object while the id is unchanged,
 * else `{ id }` until the next read (contract §4).
 */
export const keepPopulated = (prev: { id: string } | null | undefined, id: string | null | undefined) =>
  id == null ? id : prev?.id === id ? prev : { id };

export const keepPopulatedAll = (prev: Array<{ id: string }> | null | undefined, ids: string[] | null | undefined) =>
  ids == null ? ids : ids.map(id => prev?.find(p => p.id === id) ?? { id });
