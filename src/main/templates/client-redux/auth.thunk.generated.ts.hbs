{{header}}
// Auth thunk'ları: ortak olanlar + `auth.thunk.ts`'teki hook'lar ve özel thunk'lar.
// Hepsi fulfilled `LocalResponse` döner.
import type { Dispatch } from '@reduxjs/toolkit';
import type { LocalResponse } from '{{imports.localResponse}}';
import * as service from '{{imports.services}}/auth.service.generated';
import type { AuthSession, AuthUser, ChangePasswordBody, LoginBody{{#if register}}, RegisterBody, VerifyEmailBody{{/if}}{{#if otp}}, SendOtpBody{{/if}}{{#if passwordReset}}, ResetPasswordBody{{/if}}{{#if apple}}, AppleBody{{/if}}{{#if social}}, SetPasswordBody{{/if}} } from '{{imports.services}}/auth.service.generated';
import { asFailure, responseThunk } from '{{imports.services}}/api/common.generated';
import { authStorage, refreshSession } from '{{imports.api}}/auth.generated';
import { authExtension } from './auth.thunk';

export type AuthResult<T> = LocalResponse<T> & { deniedKey?: string };

export interface AuthThunkHooks {
  canSignIn?: (user: AuthUser) => string | null;
  onSession?: (session: AuthSession, dispatch: Dispatch) => void;
  onSignedOut?: (dispatch: Dispatch) => void;
}

const ended = <T>(deniedKey?: string): AuthResult<T> =>
  ({ isSuccess: false, data: null, uiMessage: '', errorData: null, ...(deniedKey ? { deniedKey } : {}) }) as unknown as AuthResult<T>;

export function createAuthThunks({ canSignIn, onSession, onSignedOut }: AuthThunkHooks = {}) {
  async function keepSession(response: AuthResult<AuthSession>, dispatch: Dispatch, remember?: boolean): Promise<AuthResult<AuthSession>> {
    if (!response.isSuccess || !response.data) return response;
    const deniedKey = canSignIn?.(response.data.user) ?? null;
    if (deniedKey) {
      service.logout(response.data.refreshToken).catch(() => undefined);
      return ended(deniedKey);
    }
    await authStorage.save(response.data.accessToken, response.data.refreshToken, remember);
    onSession?.(response.data, dispatch);
    return response;
  }

  async function signOut(dispatch: Dispatch): Promise<void> {
    await authStorage.clear();
    onSignedOut?.(dispatch);
  }

  const login = responseThunk('auth/login', async ({ remember, ...body }: LoginBody & { remember?: boolean }, { dispatch }) =>
    keepSession(await service.login(body), dispatch, remember)
  );

  const restoreSession = responseThunk('auth/restoreSession', async (_: void, { dispatch }): Promise<AuthResult<AuthUser> & { accessToken: string | null }> => {
    const { accessToken, refreshToken } = await authStorage.read();
    const usable = accessToken || (refreshToken && (await refreshSession(dispatch)));
    if (!usable) return { ...ended<AuthUser>(), accessToken: null };
    try {
      const response = await service.me();
      const deniedKey = response.isSuccess && response.data ? (canSignIn?.(response.data) ?? null) : null;
      if (deniedKey) {
        await signOut(dispatch);
        return { ...ended<AuthUser>(deniedKey), accessToken: null };
      }
      return { ...response, accessToken: (await authStorage.read()).accessToken };
    } catch (error) {
      return { ...asFailure<AuthUser>(error), accessToken: null };
    }
  });

  const logout = responseThunk('auth/logout', async (_: void, { dispatch }) => {
    const { refreshToken } = await authStorage.read();
    if (refreshToken) await service.logout(refreshToken).catch(() => undefined);
    await signOut(dispatch);
    return { isSuccess: true, data: null, uiMessage: '', errorData: null } as AuthResult<null>;
  });

  // Sunucu şifre değişince bütün oturumları kapatır.
  const changePassword = responseThunk('auth/changePassword', async (body: ChangePasswordBody, { dispatch }) => {
    const response: AuthResult<null> = await service.changePassword(body);
    if (response.isSuccess) await signOut(dispatch);
    return response;
  });

  const changePasswordAndLogin = responseThunk(
    'auth/changePasswordAndLogin',
    async ({ email, remember = true, ...body }: ChangePasswordBody & { email: string; remember?: boolean }, { dispatch }) => {
      const response = await dispatch(changePassword(body)).unwrap();
      if (response.isSuccess) await dispatch(login({ email, password: body.newPassword, remember }));
      return response;
    }
  );
{{#if register}}

  const register = responseThunk('auth/register', async (body: RegisterBody): Promise<AuthResult<null>> => service.register(body));

  const verifyEmail = responseThunk('auth/verifyEmail', async (body: VerifyEmailBody, { dispatch }) => keepSession(await service.verifyEmail(body), dispatch));
{{/if}}
{{#if otp}}

  const sendOtp = responseThunk('auth/sendOtp', async (body: SendOtpBody): Promise<AuthResult<null>> => service.sendOtp(body));
{{/if}}
{{#if passwordReset}}

  const forgotPassword = responseThunk('auth/forgotPassword', async (email: string): Promise<AuthResult<null>> => service.forgotPassword(email));

  const resetPassword = responseThunk('auth/resetPassword', async (body: ResetPasswordBody): Promise<AuthResult<null>> => service.resetPassword(body));

  const resetPasswordAndLogin = responseThunk(
    'auth/resetPasswordAndLogin',
    async ({ remember = true, ...body }: ResetPasswordBody & { remember?: boolean }, { dispatch }) => {
      const response = await dispatch(resetPassword(body)).unwrap();
      if (response.isSuccess) await dispatch(login({ email: body.email, password: body.newPassword, remember }));
      return response;
    }
  );
{{/if}}
{{#if google}}

  const loginWithGoogle = responseThunk('auth/loginWithGoogle', async (idToken: string, { dispatch }) => keepSession(await service.loginWithGoogle(idToken), dispatch));
{{/if}}
{{#if apple}}

  const loginWithApple = responseThunk('auth/loginWithApple', async (body: AppleBody, { dispatch }) => keepSession(await service.loginWithApple(body), dispatch));
{{/if}}
{{#if social}}

  const setPassword = responseThunk('auth/setPassword', async (body: SetPasswordBody): Promise<AuthResult<null>> => service.setPassword(body));
{{/if}}
{{#if accountDelete}}

  const deleteAccount = responseThunk('auth/deleteAccount', async (_: void, { dispatch }) => {
    const response: AuthResult<null> = await service.deleteAccount();
    if (response.isSuccess) await signOut(dispatch);
    return response;
  });
{{/if}}

  return { {{thunkNames}} };
}

export type AuthBaseThunks = ReturnType<typeof createAuthThunks>;

export interface AuthExtension {
  hooks: AuthThunkHooks;
  thunks: (base: AuthBaseThunks) => object;
}

const base = createAuthThunks(authExtension.hooks);

// Parametresiz yazılmış `thunks` de çağrılabilsin diye arayüz tipiyle çağrılır; dönüş tipi K'dakidir.
const custom = (authExtension.thunks as AuthExtension['thunks'])(base) as ReturnType<typeof authExtension.thunks>;

export const authThunks = { ...base, ...custom };
export type AuthThunks = typeof authThunks;
export const { {{thunkNames}} } = base;
