{{#if accountDelete}}

export const deleteAccount = createAsyncThunk('auth/deleteAccount', async () => {
  try {
    const response = await service.deleteAccount();
    if (response.isSuccess) await authStorage.clear();
    return response;
  } catch (error) {
    return failed<null>(error);
  }
});
