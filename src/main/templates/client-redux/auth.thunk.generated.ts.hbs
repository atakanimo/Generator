// Auth thunks (docs/backend/auth.md): always fulfilled with the `LocalResponse` (pages branch on `isSuccess` after
// `unwrap()`); a session answer is stored (`authStorage`) before the slice sees it. Do not edit.
import { createAsyncThunk } from '@reduxjs/toolkit';
import type { LocalResponse } from '{{imports.localResponse}}';
import * as service from '{{imports.services}}/auth.service.generated';
import type { AuthSession, AuthUser, ChangePasswordBody, LoginBody{{#if register}}, RegisterBody, VerifyEmailBody{{/if}}{{#if otp}}, SendOtpBody{{/if}}{{#if passwordReset}}, ResetPasswordBody{{/if}}{{#if apple}}, AppleBody{{/if}}{{#if social}}, SetPasswordBody{{/if}} } from '{{imports.services}}/auth.service.generated';
import { authStorage } from '{{imports.services}}/authStorage.generated';
import { refreshSessionOnce, adoptStoredAccessToken } from '{{imports.services}}/authRefresh.generated';

/** The interceptor rejects with a `LocalResponse`; anything else becomes one. */
const failed = <T>(error: unknown): LocalResponse<T> =>
  error && typeof error === 'object' && 'isSuccess' in error
    ? (error as LocalResponse<T>)
    : ({ isSuccess: false, data: null, uiMessage: '', errorData: { header: '', message: String(error), code: 0 } } as unknown as LocalResponse<T>);

async function keepSession(response: LocalResponse<AuthSession>, remember?: boolean): Promise<LocalResponse<AuthSession>> {
  if (response.isSuccess && response.data) await authStorage.save(response.data.accessToken, response.data.refreshToken, remember);
  return response;
}

/** `remember` (web): `localStorage` instead of `sessionStorage`; the phone always keeps the session. */
export const login = createAsyncThunk('auth/login', async ({ remember, ...body }: LoginBody & { remember?: boolean }) => {
  try {
    return await keepSession(await service.login(body), remember);
  } catch (error) {
    return failed<AuthSession>(error);
  }
});

/** Cold start: a stored session is checked once with `me` (an expired access token refreshes in the interceptor). */
export const restoreSession = createAsyncThunk('auth/restoreSession', async () => {
  const { accessToken, refreshToken } = await authStorage.read();
  // Only a refresh token left (e.g. the access token was dropped): renew first.
  const usable = accessToken || (refreshToken && (await refreshSessionOnce()));
  if (!usable) return { isSuccess: false, data: null, uiMessage: '', errorData: null } as unknown as LocalResponse<AuthUser> & { accessToken: string | null };
  if (accessToken) adoptStoredAccessToken(accessToken);
  try {
    return { ...(await service.me()), accessToken: (await authStorage.read()).accessToken };
  } catch (error) {
    return { ...failed<AuthUser>(error), accessToken: null };
  }
});

export const logout = createAsyncThunk('auth/logout', async () => {
  const { refreshToken } = await authStorage.read();
  try {
    if (refreshToken) await service.logout(refreshToken);
  } catch {
    // The local sign-out happens anyway.
  }
  await authStorage.clear();
  return { isSuccess: true, data: null, uiMessage: '', errorData: null } as LocalResponse<null>;
});

/** The server revokes every session of the user: the slice signs out, sign in again with the new password. */
export const changePassword = createAsyncThunk('auth/changePassword', async (body: ChangePasswordBody) => {
  try {
    const response = await service.changePassword(body);
    if (response.isSuccess) await authStorage.clear();
    return response;
  } catch (error) {
    return failed<null>(error);
  }
});
