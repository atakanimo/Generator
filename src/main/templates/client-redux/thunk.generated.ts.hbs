{{header}}
// `{{entity}}` thunk'ları; `{{camel}}.thunk.ts` bunları `create{{entity}}Thunks({ … })` ile hook'larıyla kurar.
import type { LocalResponse } from '{{imports.localResponse}}';
import * as service from '{{imports.services}}/{{camel}}.service.generated';
import type { {{serviceTypeImports}} } from '{{imports.services}}/{{camel}}.service.generated';
import { responseThunk, type RequestOptions{{#if ops.list}}, type PaginatedList{{/if}} } from '{{imports.services}}/api/common.generated';

{{#if ops.list}}
export type Get{{entity}}ListResponse = LocalResponse<PaginatedList<{{names.row}}>>;
/** `append`: next page of an infinite list (no global loading; the slice appends). */
export type Fetch{{entity}}ListArg = {{names.listBody}} & { append?: boolean };
{{/if}}
{{#if ops.getOne}}
export type Get{{entity}}Response = LocalResponse<{{names.row}}>;
{{/if}}
{{#if hasWrites}}
export type Save{{entity}}Response = LocalResponse<{{names.saved}}>;
{{/if}}
{{#if ops.update}}
export type Update{{entity}}Arg = { id: string; data: {{names.updateInput}} };
{{/if}}
{{#if ops.delete}}
export type Delete{{entity}}Response = LocalResponse<null>;
{{/if}}

/** What a hook gets besides the result: the thunk API's `dispatch` / `getState`. */
export type {{entity}}ThunkApi = { dispatch: (action: any) => any; getState: () => unknown };

export interface {{entity}}ThunkHooks {
{{#if hasReads}}
  /** Applied to every row a list / getOne answer carries (e.g. normalizing legacy values). */
  mapRow?: (row: {{names.row}}) => {{names.row}};
{{/if}}
  /** Request options per operation (e.g. a host header: `{ create: { headers: { premiumUx: 'paywall' } } }`). */
  requestOptions?: { {{requestOptionKeys}} };
{{#if ops.list}}
  /** Defaults of every list request (e.g. `{ page: 1, limit: 20 }`); the caller's body wins. */
  listDefaults?: Partial<{{names.listBody}}>;
  afterList?: (result: Get{{entity}}ListResponse, arg: Fetch{{entity}}ListArg | undefined, api: {{entity}}ThunkApi) => unknown;
{{/if}}
{{#if ops.getOne}}
  afterGetOne?: (result: Get{{entity}}Response, id: string, api: {{entity}}ThunkApi) => unknown;
{{/if}}
{{#if ops.create}}
  afterCreate?: (result: Save{{entity}}Response, data: {{names.createInput}}, api: {{entity}}ThunkApi) => unknown;
{{/if}}
{{#if ops.update}}
  afterUpdate?: (result: Save{{entity}}Response, arg: Update{{entity}}Arg, api: {{entity}}ThunkApi) => unknown;
{{/if}}
{{#if ops.delete}}
  afterDelete?: (result: Delete{{entity}}Response, id: string, api: {{entity}}ThunkApi) => unknown;
{{/if}}
}

export const create{{entity}}Thunks = (hooks: {{entity}}ThunkHooks = {}) => {
{{#if ops.list}}
  const {{thunks.list}} = responseThunk<Get{{entity}}ListResponse, Fetch{{entity}}ListArg | undefined>('{{camel}}/fetchList', async (arg, api) => {
    const { append, ...body } = arg ?? {};
    const answer = await service.getAll({ ...hooks.listDefaults, ...body }, { ...hooks.requestOptions?.list, ...(append === true ? { skipLoading: true } : {}) });
    const result: Get{{entity}}ListResponse =
      hooks.mapRow && answer.isSuccess && answer.data ? { ...answer, data: { ...answer.data, items: answer.data.items.map(hooks.mapRow) } } : answer;
    await hooks.afterList?.(result, arg, api);
    return result;
  });

{{/if}}
{{#if ops.getOne}}
  const {{thunks.getOne}} = responseThunk<Get{{entity}}Response, string>('{{camel}}/fetchById', async (id, api) => {
    const answer = await service.getById(id, hooks.requestOptions?.getOne);
    const result: Get{{entity}}Response = hooks.mapRow && answer.isSuccess && answer.data ? { ...answer, data: hooks.mapRow(answer.data) } : answer;
    await hooks.afterGetOne?.(result, id, api);
    return result;
  });

{{/if}}
{{#if ops.create}}
  const {{thunks.create}} = responseThunk<Save{{entity}}Response, {{names.createInput}}>('{{camel}}/create', async (data, api) => {
    const result = await service.create(data, hooks.requestOptions?.create);
    await hooks.afterCreate?.(result, data, api);
    return result;
  });

{{/if}}
{{#if ops.update}}
  const {{thunks.update}} = responseThunk<Save{{entity}}Response, Update{{entity}}Arg>('{{camel}}/update', async (arg, api) => {
    const result = await service.update(arg.id, arg.data, hooks.requestOptions?.update);
    await hooks.afterUpdate?.(result, arg, api);
    return result;
  });

{{/if}}
{{#if ops.delete}}
  const {{thunks.delete}} = responseThunk<Delete{{entity}}Response, string>('{{camel}}/delete', async (id, api) => {
    const result = await service.{{names.deleteFn}}(id, hooks.requestOptions?.delete);
    await hooks.afterDelete?.(result, id, api);
    return result;
  });

{{/if}}
  return { {{thunkList}} };
};

export type {{entity}}Thunks = ReturnType<typeof create{{entity}}Thunks>;
