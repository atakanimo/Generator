// Auth slice: oturum (kullanıcı, access token, açılış kontrolü) + `auth.slice.ts`'teki ek state,
// reducer, case ve selector'ler.
import { createSlice, type ActionReducerMapBuilder, type PayloadAction } from '@reduxjs/toolkit';
import type { AuthUser } from '{{imports.services}}/auth.service.generated';
import { authThunks, type AuthThunks } from '{{thunksImport}}/auth.thunk.generated';
import { authSliceExtension, type AuthExtraState } from './auth.slice';

export interface AuthBaseState {
  user: AuthUser | null;
  accessToken: string | null;
  isAuthenticated: boolean;
  checking: boolean;
  error: string | null;
}

export type AuthState = AuthBaseState & AuthExtraState;

export interface AuthSliceExtension {
  initialState: AuthExtraState;
  reducers: Record<string, (state: AuthState, action: PayloadAction<any>) => void>;
  extraReducers: (builder: ActionReducerMapBuilder<AuthState>, thunks: AuthThunks) => void;
  selectors: object;
}

const authInitialState: AuthBaseState = { user: null, accessToken: null, isAuthenticated: false, checking: true, error: null };

export type SessionChange = { accessToken: string; user: AuthUser } | null;

const signedIn = (state: AuthState, accessToken: string, user: AuthUser) => {
  state.user = user;
  state.accessToken = accessToken;
  state.isAuthenticated = true;
  state.checking = false;
  state.error = null;
};

const signedOut = (state: AuthState) => {
  Object.assign(state, authSliceExtension.initialState);
  state.user = null;
  state.accessToken = null;
  state.isAuthenticated = false;
  state.checking = false;
};

type SessionPayload = { isSuccess: boolean; data: { accessToken: string; user: AuthUser } | null; deniedKey?: string };

const session = (state: AuthState, { payload }: { payload: SessionPayload }) => {
  state.error = payload.deniedKey ?? null;
  if (payload.isSuccess && payload.data) signedIn(state, payload.data.accessToken, payload.data.user);
};

const authSlice = createSlice({
  name: 'auth',
  initialState: { ...authInitialState, ...authSliceExtension.initialState } as AuthState,
  reducers: {
    sessionChanged: (state, { payload }: PayloadAction<SessionChange>) =>
      payload ? signedIn(state, payload.accessToken, payload.user) : signedOut(state),
    tokenAdopted: (state, { payload }: PayloadAction<string>) => {
      state.accessToken = payload;
    },
    clearSession: signedOut,
    ...authSliceExtension.reducers
  },
  extraReducers: builder => {
    builder
      .addCase(authThunks.login.fulfilled, session)
      .addCase(authThunks.restoreSession.fulfilled, (state, { payload }) => {
        if (!payload.isSuccess || !payload.data) {
          signedOut(state);
          state.error = payload.deniedKey ?? null;
          return;
        }
        state.user = payload.data;
        state.accessToken = payload.accessToken;
        state.isAuthenticated = true;
        state.checking = false;
      })
      .addCase(authThunks.logout.fulfilled, signedOut)
      .addCase(authThunks.changePassword.fulfilled, (state, { payload }) => {
        if (payload.isSuccess) signedOut(state);
      }){{#if register}}
      .addCase(authThunks.verifyEmail.fulfilled, session){{/if}}{{#if google}}
      .addCase(authThunks.loginWithGoogle.fulfilled, session){{/if}}{{#if apple}}
      .addCase(authThunks.loginWithApple.fulfilled, session){{/if}}{{#if social}}
      .addCase(authThunks.setPassword.fulfilled, (state, { payload }) => {
        if (payload.isSuccess && state.user) state.user.hasPassword = true;
      }){{/if}}{{#if accountDelete}}
      .addCase(authThunks.deleteAccount.fulfilled, (state, { payload }) => {
        if (payload.isSuccess) signedOut(state);
      }){{/if}};
    (authSliceExtension.extraReducers as AuthSliceExtension['extraReducers'])(builder, authThunks);
  }
});

export const GetAuthState = (state: { auth: AuthState }) => state.auth;
export const authActions = authSlice.actions;
export const { sessionChanged, tokenAdopted, clearSession } = authSlice.actions;
export const authSelectors = authSliceExtension.selectors;
export const authReducer = authSlice.reducer;
export default authSlice.reducer;
