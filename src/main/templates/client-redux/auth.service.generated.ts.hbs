{{header}}
// Ortak auth uçları ve tipleri (`{{prefix}}/auth`, modüller: {{moduleList}}) + projeye özel uçlar (`auth.service.ts`).
import { API } from '{{imports.api}}/api.generated';
import type { LocalResponse } from '{{imports.localResponse}}';
import { type RequestOptions, requestFlags } from './api/common.generated';

export type AuthRole = 'admin' | 'user';

export interface AuthUser {
  id: string;
  email: string;
  name: string;
  role: AuthRole;
  provider: 'password' | 'google' | 'apple';
  emailVerified: boolean;
  hasPassword: boolean;
}

export interface AuthSession {
  accessToken: string;
  refreshToken: string;
  expiresIn: number;
  user: AuthUser;
  isNewUser?: boolean;
}

export const AUTH_STORAGE_PREFIX = '{{storagePrefix}}';

export const AUTH_EMAIL_NOT_VERIFIED = 463;

export const AUTH_ENDPOINTS = {
  login: '{{prefix}}/auth/login',
  refresh: '{{prefix}}/auth/refresh',
  logout: '{{prefix}}/auth/logout',
  me: '{{prefix}}/auth/me',
  changePassword: '{{prefix}}/auth/change-password',
  adminSetPassword: '{{prefix}}/auth/admin/set-password'{{#if register}},
  register: '{{prefix}}/auth/register',
  verifyEmail: '{{prefix}}/auth/verify-email'{{/if}}{{#if otp}},
  sendOtp: '{{prefix}}/auth/send-otp'{{/if}}{{#if passwordReset}},
  forgotPassword: '{{prefix}}/auth/forgot-password',
  resetPassword: '{{prefix}}/auth/reset-password'{{/if}}{{#if google}},
  google: '{{prefix}}/auth/google'{{/if}}{{#if apple}},
  apple: '{{prefix}}/auth/apple'{{/if}}{{#if social}},
  setPassword: '{{prefix}}/auth/set-password'{{/if}}{{#if accountDelete}},
  account: '{{prefix}}/auth/account'{{/if}}
} as const;

export interface LoginBody {
  email: string;
  password: string;
}

export interface ChangePasswordBody {
  currentPassword: string;
  newPassword: string;
}

export interface AdminSetPasswordBody {
  userId: string;
  newPassword: string;
}
{{#if register}}

export interface RegisterBody {
  email: string;
  password: string;
  name: string;
}

export interface VerifyEmailBody {
  email: string;
  code: string;
}
{{/if}}
{{#if otp}}

export interface SendOtpBody {
  email: string;
  purpose: {{otpPurposes}};
}
{{/if}}
{{#if passwordReset}}

export interface ResetPasswordBody {
  email: string;
  code: string;
  newPassword: string;
}
{{/if}}
{{#if apple}}

export interface AppleBody {
  identityToken: string;
  authorizationCode?: string;
  fullName?: string;
}
{{/if}}
{{#if social}}

export interface SetPasswordBody {
  newPassword: string;
}
{{/if}}

const quiet = (options?: RequestOptions, background = false): RequestOptions => ({
  skipSuccessToast: true,
  ...(background ? { skipLoading: true } : {}),
  ...options
});

export const login = (body: LoginBody, options?: RequestOptions): Promise<LocalResponse<AuthSession>> =>
  API({ url: AUTH_ENDPOINTS.login, method: 'POST', data: body, ...requestFlags(quiet(options)) });

export const refresh = (refreshToken: string, options?: RequestOptions): Promise<LocalResponse<AuthSession>> =>
  API({ url: AUTH_ENDPOINTS.refresh, method: 'POST', data: { refreshToken }, ...requestFlags(quiet(options, true)) });

export const logout = (refreshToken: string | null, options?: RequestOptions): Promise<LocalResponse<null>> =>
  API({ url: AUTH_ENDPOINTS.logout, method: 'POST', data: { refreshToken }, ...requestFlags(quiet(options, true)) });

export const me = (options?: RequestOptions): Promise<LocalResponse<AuthUser>> =>
  API({ url: AUTH_ENDPOINTS.me, method: 'GET', ...requestFlags({ skipLoading: true, ...options }, true) });

export const changePassword = (body: ChangePasswordBody, options?: RequestOptions): Promise<LocalResponse<null>> =>
  API({ url: AUTH_ENDPOINTS.changePassword, method: 'POST', data: body, ...requestFlags(options) });

export const adminSetPassword = (body: AdminSetPasswordBody, options?: RequestOptions): Promise<LocalResponse<null>> =>
  API({ url: AUTH_ENDPOINTS.adminSetPassword, method: 'POST', data: body, ...requestFlags(options) });
{{#if register}}

export const register = (body: RegisterBody, options?: RequestOptions): Promise<LocalResponse<null>> =>
  API({ url: AUTH_ENDPOINTS.register, method: 'POST', data: body, ...requestFlags(options) });

export const verifyEmail = (body: VerifyEmailBody, options?: RequestOptions): Promise<LocalResponse<AuthSession>> =>
  API({ url: AUTH_ENDPOINTS.verifyEmail, method: 'POST', data: body, ...requestFlags(options) });
{{/if}}
{{#if otp}}

export const sendOtp = (body: SendOtpBody, options?: RequestOptions): Promise<LocalResponse<null>> =>
  API({ url: AUTH_ENDPOINTS.sendOtp, method: 'POST', data: body, ...requestFlags(options) });
{{/if}}
{{#if passwordReset}}

export const forgotPassword = (email: string, options?: RequestOptions): Promise<LocalResponse<null>> =>
  API({ url: AUTH_ENDPOINTS.forgotPassword, method: 'POST', data: { email }, ...requestFlags(options) });

export const resetPassword = (body: ResetPasswordBody, options?: RequestOptions): Promise<LocalResponse<null>> =>
  API({ url: AUTH_ENDPOINTS.resetPassword, method: 'POST', data: body, ...requestFlags(options) });
{{/if}}
{{#if google}}

export const loginWithGoogle = (idToken: string, options?: RequestOptions): Promise<LocalResponse<AuthSession>> =>
  API({ url: AUTH_ENDPOINTS.google, method: 'POST', data: { idToken }, ...requestFlags(options) });
{{/if}}
{{#if apple}}

export const loginWithApple = (body: AppleBody, options?: RequestOptions): Promise<LocalResponse<AuthSession>> =>
  API({ url: AUTH_ENDPOINTS.apple, method: 'POST', data: body, ...requestFlags(options) });
{{/if}}
{{#if social}}

export const setPassword = (body: SetPasswordBody, options?: RequestOptions): Promise<LocalResponse<null>> =>
  API({ url: AUTH_ENDPOINTS.setPassword, method: 'POST', data: body, ...requestFlags(options) });
{{/if}}
{{#if accountDelete}}

export const deleteAccount = (options?: RequestOptions): Promise<LocalResponse<null>> =>
  API({ url: AUTH_ENDPOINTS.account, method: 'DELETE', ...requestFlags(options) });
{{/if}}

export * from './auth.service';
