{
  "name": "__app__",
  "version": "0.1.0",
  "private": true,
  "description": "__App__ backend: Express + Mongoose + TypeScript (Generator)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.1",
    "i18next": "25.10.10",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.19.3",
    "pino": "9.14.0",
    "pino-pretty": "13.1.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "tsc-alias": "1.8.16",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
