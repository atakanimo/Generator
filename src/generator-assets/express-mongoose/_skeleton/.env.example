# Kopyalayın: cp .env.example .env  (.env git dışında kalır)
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/__app__
# En az 32 karakter; yoksa uygulama açılmaz.
JWT_SECRET=
# Ayarlıysa token'da denetlenir.
JWT_ISSUER=
JWT_AUDIENCE=
# Admin: token'daki `role` (string ya da liste) bu değeri içerir, ya da kullanıcı id'si ADMIN_USER_IDS'tedir (virgülle).
ADMIN_ROLE=admin
ADMIN_USER_IDS=
# Üretimde izinli origin'ler (virgülle); geliştirmede her origin kabul edilir.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
