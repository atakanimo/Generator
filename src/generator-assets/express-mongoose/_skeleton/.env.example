# Kopyalayın: cp .env.example .env  (.env git dışında kalır)
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/__app__
# En az 32 karakter; yoksa uygulama açılmaz.
JWT_SECRET=
# Ayarlıysa token'da denetlenir.
JWT_ISSUER=
JWT_AUDIENCE=
# Access token süresi (dakika) ve refresh token süresi (gün).
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_GENERAL=120/60
RATE_LIMIT_ADMIN_READ=600/900
RATE_LIMIT_ADMIN_WRITE=120/900
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Üretimde izinli origin'ler (virgülle); geliştirmede her origin kabul edilir.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
