# Production: backend kökü (ör. https://api.example.com). Boşsa istekler panelle aynı origin'e gider.
VITE_API_BASE_URL=
# Yalnız `npm run dev`: `/api` istekleri bu adrese yönlenir (Vite proxy).
VITE_API_PROXY=__API_DEV_URL__
# prod | test (menü başlığındaki ortam etiketi; boşsa build → prod, dev → test)
VITE_APP_ENV=
