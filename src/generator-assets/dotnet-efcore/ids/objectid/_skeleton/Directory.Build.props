<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kimlik tipi: MongoDB ObjectId. Bütün projelerde EntityId (Domain/Common/EntityIds.cs). -->
    <Using Include="MongoDB.Bson.ObjectId" Alias="EntityId" />
  </ItemGroup>
</Project>
