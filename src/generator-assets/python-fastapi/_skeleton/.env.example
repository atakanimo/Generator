# Kopyala: cp .env.example .env  (git'e girmez)
ENVIRONMENT=development
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=__app__
# HS256, en az 32 karakter; boşsa API açılmaz.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
# Access token süresi (dakika), refresh token süresi (gün).
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_GENERAL=120/60
RATE_LIMIT_ADMIN_READ=600/900
RATE_LIMIT_ADMIN_WRITE=120/900
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
