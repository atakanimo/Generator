# Kopyala: cp .env.example .env  (git'e girmez)
ENVIRONMENT=development
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=__app__
# HS256, en az 32 karakter; boşsa API açılmaz.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
# Access token süresi (dakika), refresh token süresi (gün), login / kod uçlarında IP başına dakikalık sınır.
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
