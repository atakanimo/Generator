{
  "name": "@atakanimo/ata-admin-base",
  "version": "0.1.15",
  "description": "Config-driven admin UI runtime for Generator output (resource schemas, data provider, TanStack Query hooks, MUI pages).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atakanimo/Generator.git",
    "directory": "packages/admin-base"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "playground": "vite --config playground/vite.config.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release": "bash scripts/publish.sh"
  },
  "dependencies": {
    "react-hook-form": "^7.90.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "@mui/x-data-grid": "^9.0.0",
    "@mui/x-date-pickers": "^8.0.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.0.0",
    "chart.js": "^4.4.0",
    "dayjs": "^1.11.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-data-grid": "^9.15.0",
    "@mui/x-date-pickers": "^8.29.4",
    "@tanstack/react-query": "^5.104.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
